generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Barber {
  id           String        @id @default(cuid())
  name         String
  nickname     String?
  email        String?
  phone        String?
  avatarUrl    String?
  color        String        @default("#d97706")
  isActive     Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Service {
  id              String        @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int           @default(30)
  price           Float
  category        String        @default("HAIR") // HAIR, BEARD, COMBO, TREATMENT
  color           String        @default("#d97706")
  order           Int           @default(0)
  isActive        Boolean       @default(true)
  appointments    Appointment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Client {
  id             String        @id @default(cuid())
  firstName      String
  lastName       String
  phone          String
  email          String?
  notes          String?       // Note stile, sfumatura, barba
  loyaltyPoints  Int           @default(0)
  privacyConsent Boolean       @default(true)
  appointments   Appointment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Appointment {
  id            String   @id @default(cuid())
  barberId      String
  barber        Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  date          DateTime
  startTime     String   // Formato "HH:mm" es. "10:30"
  endTime       String   // Formato "HH:mm" es. "11:00"
  status        String   @default("CONFIRMED") // PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
  channel       String   @default("WEB") // WEB, PHONE, WALK_IN, WHATSAPP, MANUAL
  notes         String?
  internalNotes String?
  pricePaid     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorkingHours {
  id         String   @id @default(cuid())
  dayOfWeek  Int      @unique // 0 = Domenica, 1 = Lunedì, ..., 6 = Sabato
  startTime  String   @default("09:00")
  endTime    String   @default("19:30")
  breakStart String?  @default("13:00")
  breakEnd   String?  @default("14:00")
  isOpen     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TenantLocalCache {
  id                  String   @id @default("singleton")
  domain              String
  licenseStatus       String   @default("ATTIVO") // ATTIVO, SOSPESO, IN_SCADENZA
  enabledModules      String   @default("[]") // JSON stringified array of module keys
  brandName           String   @default("Barberly Salon")
  logoUrl             String?
  faviconUrl          String?
  primaryColor        String   @default("#0f172a")
  accentColor         String   @default("#d97706")
  contactEmail        String?
  phone               String?
  address             String   @default("Via Roma, 42 — Milano (MI)")
  whatsappNumber      String?  @default("+39 340 123 4567")
  whatsappProvider    String?  @default("WA_ME")
  slotIntervalMinutes Int      @default(30)
  rispettaFestivitaNazionali Boolean @default(true)
  cancelHoursNotice   Int      @default(24)
  showcaseConfig      String?  @default("{}")
  telegramEnabled     Boolean   @default(false)
  telegramBotToken    String?
  telegramBotUsername String?
  telegramStaffChatId String?
  fidelityEnabled     Boolean   @default(false)
  fidelityRules       String?   @default("{}")
  lastSyncedAt        DateTime @default(now())
  // 🛡️ Sicurezza v1.0.6: 2FA / MFA, Brute Force & Audit
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  mfaBackupCodes      String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int       @default(1)
}

// Dispositivi PWA FIDO2 / Biometrici autorizzati per avvio rapido con PIN/Impronta
model RegisteredDevice {
  id           String    @id @default(cuid())
  deviceName   String    // Es. "iPhone 15 Pro", "Tablet Cassa Salone"
  deviceType   String    @default("mobile") // mobile, tablet, desktop
  credentialId String    @unique // ID univoco generato dal chip hardware Secure Enclave
  publicKey    String    // Chiave pubblica FIDO2 codificata base64url
  counter      BigInt    @default(0) // Contatore anti-clonazione
  transports   String    @default("[]") // internal, usb, ble, nfc (JSON string)
  status       String    @default("ACTIVE") // ACTIVE | REVOKED
  lastUsedAt   DateTime?
  lastIp       String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// Sfide crittografiche monouso per registrazione e login WebAuthn
model WebAuthnChallenge {
  challenge String   @id
  type      String   // registration | authentication
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}


model TrustedDevice {
  id          String    @id @default(cuid())
  deviceHash  String    @unique
  deviceName  String
  deviceType  String    @default("desktop")
  browser     String?
  os          String?
  ipAddress   String?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
}

model AccessLog {
  id          String    @id @default(cuid())
  esito       String
  ipAddress   String
  userAgent   String?
  deviceType  String    @default("desktop")
  browser     String?
  os          String?
  mfaUsed     Boolean   @default(false)
  dettaglio   String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

model EccezioneCalendario {
  id          String   @id @default(cuid())
  data        String   @unique // Formato "YYYY-MM-DD"
  tipo        String   @default("CHIUSURA") // CHIUSURA, APERTURA_STRAORDINARIA, ORARIO_SPECIALE
  titolo      String   // es. "Natale", "Vigilia di Natale", "Apertura Feste"
  oraInizio   String?  // es. "09:00"
  oraFine     String?  // es. "19:00"
  pausaInizio String?  // es. "13:00"
  pausaFine   String?  // es. "14:00"
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
