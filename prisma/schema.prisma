generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Barber {
  id           String        @id @default(cuid())
  name         String
  nickname     String?
  email        String?
  phone        String?
  avatarUrl    String?
  isActive     Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Service {
  id              String        @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int           @default(30)
  price           Float
  category        String        @default("HAIR") // HAIR, BEARD, COMBO, TREATMENT
  isActive        Boolean       @default(true)
  appointments    Appointment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Client {
  id            String        @id @default(cuid())
  firstName     String
  lastName      String
  phone         String
  email         String?
  notes         String?
  loyaltyPoints Int           @default(0)
  appointments  Appointment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Appointment {
  id         String   @id @default(cuid())
  barberId   String
  barber     Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  date       DateTime
  startTime  String   // Formato "HH:mm" es. "10:30"
  endTime    String   // Formato "HH:mm" es. "11:00"
  status     String   @default("CONFIRMED") // PENDING, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  notes      String?
  pricePaid  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TenantLocalCache {
  id             String   @id @default("singleton")
  domain         String
  licenseStatus  String   @default("ATTIVO") // ATTIVO, SOSPESO, IN_SCADENZA
  enabledModules String   @default("[]") // JSON stringified array of module keys
  brandName      String   @default("Barberly Salon")
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String   @default("#0f172a")
  accentColor    String   @default("#d97706")
  contactEmail   String?
  phone          String?
  lastSyncedAt   DateTime @default(now())
}

// Dispositivi PWA FIDO2 / Biometrici autorizzati per avvio rapido con PIN/Impronta
model RegisteredDevice {
  id           String    @id @default(cuid())
  deviceName   String    // Es. "iPhone 15 Pro", "Tablet Cassa Salone"
  deviceType   String    @default("mobile") // mobile, tablet, desktop
  credentialId String    @unique // ID univoco generato dal chip hardware Secure Enclave
  publicKey    String    // Chiave pubblica FIDO2 codificata base64url
  counter      BigInt    @default(0) // Contatore anti-clonazione
  transports   String    @default("[]") // internal, usb, ble, nfc (JSON string)
  status       String    @default("ACTIVE") // ACTIVE | REVOKED
  lastUsedAt   DateTime?
  lastIp       String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// Sfide crittografiche monouso per registrazione e login WebAuthn
model WebAuthnChallenge {
  challenge String   @id
  type      String   // registration | authentication
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}
