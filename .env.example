# Configurazione Database SQLite isolato per Tenant
DATABASE_URL="file:./dev.db"

# Integrazione Taaaac Core (https://taaaac.eu)
# Endpoint: GET https://taaaac.eu/api/public/tenant-config?domain=[domain]&token=[token]
TAAAAC_CORE_URL="https://taaaac.eu"
TAAAAC_TENANT_DOMAIN="barberly-demo.taaaac.eu"
TAAAAC_TENANT_TOKEN="demo-token-barberly"

# Nome Applicazione
NEXT_PUBLIC_APP_NAME="Barberly"
